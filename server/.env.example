# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Kraken API Credentials
# Get from: https://www.kraken.com/u/security/api
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# Plaid API Credentials
# Get from: https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox
# Options: sandbox, development, production

# Optional: Pre-configured Plaid Access Tokens
# These are obtained after completing the Plaid Link flow once
PLAID_ACCESS_TOKEN_BOFA=
PLAID_ACCESS_TOKEN_PUBLIC=

# Finnhub API Key (for stock market data)
# Get free key from: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# CoinGecko (free tier, no key required for basic endpoints)
# COINGECKO_API_KEY=optional_pro_key_here
